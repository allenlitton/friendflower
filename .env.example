# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses privacy rules — only used to store hashed contacts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret used to scramble phone numbers/emails before storing them.
# Generate once with:  openssl rand -hex 32
# NEVER change it after launch, or existing contact matches stop working.
CONTACT_HASH_PEPPER=

# Push notifications (iPhone app). From developer.apple.com -> Keys -> an APNs key (.p8).
APNS_KEY_ID=
APNS_TEAM_ID=
# The whole .p8 file's text (newlines may be written as \n).
APNS_PRIVATE_KEY=
# Optional; defaults to app.friendflower.ios.
APNS_TOPIC=
# Random secret the database sends to /api/push/send. Generate with: openssl rand -hex 32
# Also store it in the database: insert into private.push_config (url, secret) values ('https://friendflower.app/api/push/send', '<same secret>');
PUSH_SECRET=

# App Store review login. This one email also accepts this fixed code (8-10 digits),
# so Apple's reviewer can sign in without our email. Leave blank to turn it off.
REVIEW_EMAIL=
REVIEW_CODE=
